# Copy this file to `.env` before your first deploy.
#
# Windows:
#   copy .env.example .env
#
# Linux:
#   cp .env.example .env

# --------------------------------------------------
# Server
# --------------------------------------------------
NODE_ENV=production
PORT=4010

# Public site origin used by the backend when building absolute URLs.
# Example: https://api.diary.yourdomain.com
PUBLIC_SITE_ORIGIN=https://api.example.com

# Optional CDN / static asset domain.
# If you do not use a separate CDN, set this to the same value as PUBLIC_SITE_ORIGIN.
PUBLIC_ASSET_ORIGIN=https://api.example.com

# Optional local upload storage.
# Recommended for server deploys when you want uploads outside the repo working tree.
# Example:
# UPLOAD_STORAGE_ROOT=/www/wwwroot/grudge-diary-backend/public/uploads
# UPLOAD_STORAGE_ROOT=

# --------------------------------------------------
# Admin
# --------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# 后台登录令牌有效期（小时），可选，默认 168（7 天），范围 1 ~ 2160。
# 令牌已改为登录时签发、入库（仅存哈希）、可过期、可吊销，不再需要静态 ADMIN_ACCESS_TOKEN。
# ADMIN_SESSION_TTL_HOURS=168

# --------------------------------------------------
# Database: MySQL 8.0
# --------------------------------------------------
# Example:
# mysql://diary_user:strong_password@127.0.0.1:3306/grudge_diary?charset=utf8mb4
DATABASE_URL="mysql://diary_user:strong_password@127.0.0.1:3306/grudge_diary?charset=utf8mb4"

# --------------------------------------------------
# WeChat Mini Program
# --------------------------------------------------
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_SECRET=

# --------------------------------------------------
# Optional Qiniu object storage
# --------------------------------------------------
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_ZONE=z0
QINIU_UPLOAD_PREFIX=uploads
