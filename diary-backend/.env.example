# 复制为 .env 后按需修改（勿把真实 .env 提交到 Git）
#   cp .env.example .env

# ========== 后台管理（已生效：lib/admin-auth.ts）==========
# 登录校验为精确匹配（已自动 trim），勿在等号两侧留空格；密码勿加引号除非密码本身含空格
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码
# 管理接口 Bearer Token，请改为长随机串；修改后需重新登录后台
ADMIN_ACCESS_TOKEN=请改为长随机串

# ========== MySQL / Prisma ==========
# 开发环境未设置或留空时，业务使用内存 WallpaperStore（便于本地无库开发）。
# 生产环境未设置 DATABASE_URL 时，服务会直接报错并进入不健康状态，不再静默回退内存存储。
# 设置有效的 DATABASE_URL 后，进程使用 Prisma + MySQL（DbWallpaperStore）。
# 密码含特殊字符时请 URL 编码（如 @ -> %40）
DATABASE_URL="mysql://wallpaper:你的密码@127.0.0.1:3306/wallpaper?charset=utf8mb4"
#
# 首次建表（生产服务器项目根目录）：
#   npx prisma migrate deploy
# （含 wallpaper_tag 标签表后，可 npm run db:seed 写入默认标签；表非空则跳过）
# 可选写入 5 条 demo 壁纸（需 public/uploads/wallpapers/demo_*.jpg 已存在）：
#   npm run db:seed
# 然后重新构建并重启进程，例如：
#   npm run build
#   pm2 start ecosystem.config.cjs
# （npm start / PM2 均通过 scripts/start-production.cjs 自动加载本目录 .env，无需在 PM2 里重复写 ADMIN_*）
#   pm2 restart wallpaper-backend
# 若登录仍 401：执行 pm2 logs wallpaper-backend，启动时应出现「已读取 ADMIN_USERNAME / ADMIN_PASSWORD」
#（表示 .env 里有这两项，不是密码内容）；若显示「缺少」，说明键名或路径不对

# 若你用手写 mysql2 连接，可改用拆分变量（需在代码里读取）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=wallpaper
# DB_PASSWORD=你的密码
# DB_NAME=wallpaper

# ========== 微信小程序登录（jscode2session → openid）==========
# 生产环境（NODE_ENV=production）必须配置，否则小程序无法登录。
# 开发环境可不配：后端使用固定 __local_dev_openid__，便于本地无密钥调试。
# 微信公众平台 → 开发 → 开发管理 → 开发设置 → AppId / AppSecret
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_SECRET=
# 仅本地调试：跳过微信 img_sec_check（生产勿开启）
# WECHAT_IMG_SEC_CHECK_SKIP=1

# ========== 可选：上传落盘目录（解决「上传成功但 /uploads/ 图片 404」）==========
# 不设时默认 {项目根}/public/uploads（依赖进程 cwd 为项目根，见 scripts/start-production.cjs）。
# 若 PM2 cwd 不对、或 Nginx 已改为直接从磁盘提供 /uploads/，请设为绝对路径，且与 Nginx 中
# location ^~ /uploads/ 的 root（…/public）一致，例如：
# UPLOAD_STORAGE_ROOT=/www/wwwroot/wallpaper-backend/public/uploads
#
# 线上已有记录但文件在错误目录时：在服务器上 find 查 fileName，把文件挪到上述目录下对应子文件夹后刷新。

# ========== 可选：运行端口（PM2 也可用 ecosystem 里的 PORT，不必重复）==========
# PORT=3010

# ========== 可选：对外站点根（建议 https，无末尾斜杠）==========
# 登录/上传等返回的绝对 URL 优先用它；只写域名时也会按 https 解析。
# 不设时：公网 Host 默认生成 https 链接；仅本机/内网 IP 仍可用 http 便于本地调试。
# PUBLIC_SITE_ORIGIN=https://wallpaper.api.itianci.cn

# ========== 可选：静态资源站点根（建议 https，无末尾斜杠）==========
# 壁纸缩略图等静态资源文件的访问 URL 优先用它；只写域名时也会按 https 解析。
PUBLIC_ASSET_ORIGIN=https://wallpaper.cdn.itianci.cn

# ========== 七牛对象存储（可选）==========
# 仅用于 wallpapers / user_uploads 上传（avatars / system 仍落盘到服务器）。
# key 默认写入 {QINIU_UPLOAD_PREFIX}/{subdir}/{fileName}（默认 prefix=uploads）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=tianciyinji
# 区域：z0/z1/z2/na0/as0（可选；不填则用默认）
QINIU_ZONE=z0
# 可选：上传 key 前缀（默认 uploads；不要带首尾斜杠）
QINIU_UPLOAD_PREFIX=uploads
#
# 批量修正老用户默认头像（scripts/migrate-default-avatar.ts）也依赖此项：
# 先 dry-run：npx tsx scripts/migrate-default-avatar.ts --dry-run
# 再执行：npm run db:migrate-default-avatar
