# Copy to .env and adjust values for your environment.
#
# cp .env.example .env

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_ACCESS_TOKEN=change-this-to-a-long-random-token

# MySQL / Prisma
DATABASE_URL="mysql://diary_user:your_password@127.0.0.1:3306/grudge_diary?charset=utf8mb4"

# First time setup
# npx prisma migrate deploy
# npm run db:seed
# npm run build

# WeChat mini-program login
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_SECRET=

# Optional server origin config
# PUBLIC_SITE_ORIGIN=https://your-api.example.com
# PUBLIC_ASSET_ORIGIN=https://your-cdn.example.com

# Optional local upload storage
# UPLOAD_STORAGE_ROOT=/absolute/path/to/public/uploads

# Optional service port
# PORT=3000

# Optional Qiniu object storage
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_ZONE=z0
QINIU_UPLOAD_PREFIX=uploads
