# Copy this file to `.env` before your first deploy.
#
# Windows:
#   copy .env.example .env
#
# Linux:
#   cp .env.example .env

# --------------------------------------------------
# Server
# --------------------------------------------------
NODE_ENV=production
PORT=4010

# Public site origin used by the backend when building absolute URLs.
# Example: https://api.diary.yourdomain.com
PUBLIC_SITE_ORIGIN=https://api.example.com

# 图片等静态资源域名。用 R2 时填 R2 的公开访问域名（r2.dev 或自定义域名）；
# 不用 R2 则设为与 PUBLIC_SITE_ORIGIN 相同即可。
PUBLIC_ASSET_ORIGIN=https://pub-fc10276484094a82a75843f36f4c6cfb.r2.dev

# Optional local upload storage.
# Recommended for server deploys when you want uploads outside the repo working tree.
# Example:
# UPLOAD_STORAGE_ROOT=/www/wwwroot/grudge-diary-backend/public/uploads
# UPLOAD_STORAGE_ROOT=

# --------------------------------------------------
# Admin
# --------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# 后台登录令牌有效期（小时），可选，默认 168（7 天），范围 1 ~ 2160。
# 令牌已改为登录时签发、入库（仅存哈希）、可过期、可吊销，不再需要静态 ADMIN_ACCESS_TOKEN。
# ADMIN_SESSION_TTL_HOURS=168

# --------------------------------------------------
# Database: SQLite
# --------------------------------------------------
# 路径相对于 prisma/schema.prisma 所在目录，因此 file:../db/dev.db 实际指向 diary-backend/db/dev.db。
# 生产建议用绝对路径，例如：
# DATABASE_URL="file:/www/wwwroot/grudge-diary-backend/db/prod.db"
DATABASE_URL="file:../db/dev.db"

# --------------------------------------------------
# WeChat Mini Program
# --------------------------------------------------
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_SECRET=

# --------------------------------------------------
# Optional Cloudflare R2 object storage (S3 兼容)
# --------------------------------------------------
# 配齐 ACCESS_KEY_ID + SECRET_ACCESS_KEY + BUCKET + (ACCOUNT_ID 或 ENDPOINT) 后，
# 所有图片都会上传到 R2；不配则回退到本地 public/uploads（或 UPLOAD_STORAGE_ROOT）。
#
# 目录规则：头像 -> <R2_UPLOAD_PREFIX>/avatar，其他图片 -> <R2_UPLOAD_PREFIX>/images。
# 默认 R2_UPLOAD_PREFIX=diary，即 diary/avatar 与 diary/images。
#
# S3 API 形如 https://<account_id>.r2.cloudflarestorage.com/<bucket>，
# 因此 account_id 填到 R2_ACCOUNT_ID，bucket 填到 R2_BUCKET。
R2_ACCOUNT_ID=89c04a99a4ae9a6819bb4ccbadb04fe3
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=my-images
R2_UPLOAD_PREFIX=diary
#
# R2 的公开访问域名（r2.dev 公共域名或绑定的自定义域名），用于拼图片 URL。
# 配了 R2 时，请把 PUBLIC_ASSET_ORIGIN 指向这个域名，例如：
# PUBLIC_ASSET_ORIGIN=https://pub-xxxxxxxx.r2.dev
