generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 说明：SQLite 不支持 Prisma enum 与原生类型（@db.VarChar/@db.Text），
// 因此 status / type 用 String 存储，取值约束由 lib/diary-status.ts 统一兜底。

/// 后台管理会话：登录时签发不透明随机令牌，库里只存其 SHA-256（泄库也拿不到原始令牌）。
/// 支持过期（expiresAt）与吊销（删除记录），取代此前静态、不可吊销的环境变量令牌。
model AdminSession {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique @map("token_hash")
  username   String   @default("")
  ip         String   @default("")
  userAgent  String   @default("") @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@index([expiresAt])
  @@map("admin_session")
}

model WxUser {
  id                 Int                    @id @default(autoincrement())
  openId             String                 @unique @map("open_id")
  accessToken        String                 @unique @map("access_token")
  nickname           String                 @default("记仇用户")
  avatar             String                 @default("")
  bio                String                 @default("")
  totalEntryCount    Int                    @default(0) @map("total_entry_count")
  activeEntryCount   Int                    @default(0) @map("active_entry_count")
  resolvedEntryCount Int                    @default(0) @map("resolved_entry_count")
  lastEntryAt        DateTime?              @map("last_entry_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  entries            DiaryEntry[]
  followUps          DiaryEntryFollowUp[]
  attachments        DiaryEntryAttachment[]

  @@index([createdAt])
  @@index([lastEntryAt])
  @@map("wx_user")
}

model DiaryCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String       @default("")
  color       String       @default("#E85D75")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  entries     DiaryEntry[]

  @@index([sortOrder])
  @@map("diary_category")
}

model DiaryTag {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  color     String          @default("#577590")
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  entryTags DiaryEntryTag[]

  @@index([sortOrder])
  @@map("diary_tag")
}

model DiaryEntry {
  id             Int                    @id @default(autoincrement())
  userId         Int                    @map("user_id")
  categoryId     Int?                   @map("category_id")
  title          String
  content        String
  targetName     String                 @default("") @map("target_name")
  targetRelation String                 @default("") @map("target_relation")
  location       String                 @default("")
  grievanceLevel Int                    @default(3) @map("grievance_level")
  emotionLevel   Int                    @default(3) @map("emotion_level")
  followUpCount  Int                    @default(0) @map("follow_up_count")
  status         String                 @default("OPEN")
  isPinned       Boolean                @default(false) @map("is_pinned")
  happenedAt     DateTime               @map("happened_at")
  settledAt      DateTime?              @map("settled_at")
  lastFollowUpAt DateTime?              @map("last_follow_up_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  user           WxUser                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       DiaryCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           DiaryEntryTag[]
  attachments    DiaryEntryAttachment[]
  followUps      DiaryEntryFollowUp[]

  @@index([userId, status, happenedAt])
  @@index([categoryId, happenedAt])
  @@index([isPinned, createdAt])
  @@index([lastFollowUpAt])
  @@map("diary_entry")
}

model DiaryEntryTag {
  id        Int        @id @default(autoincrement())
  entryId   Int        @map("entry_id")
  tagId     Int        @map("tag_id")
  createdAt DateTime   @default(now()) @map("created_at")
  entry     DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag       DiaryTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([entryId, tagId])
  @@index([tagId])
  @@map("diary_entry_tag")
}

model DiaryEntryAttachment {
  id        Int        @id @default(autoincrement())
  entryId   Int        @map("entry_id")
  userId    Int        @map("user_id")
  fileUrl   String     @map("file_url")
  fileName  String     @default("") @map("file_name")
  fileType  String     @default("image") @map("file_type")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  entry     DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      WxUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, sortOrder])
  @@index([userId, createdAt])
  @@map("diary_entry_attachment")
}

model DiaryEntryFollowUp {
  id           Int        @id @default(autoincrement())
  entryId      Int        @map("entry_id")
  userId       Int        @map("user_id")
  type         String     @default("NOTE")
  content      String
  emotionDelta Int        @default(0) @map("emotion_delta")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  entry        DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user         WxUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
  @@index([userId, createdAt])
  @@map("diary_entry_follow_up")
}
