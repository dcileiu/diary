generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DiaryEntryStatus {
  OPEN
  COOLING
  RECONCILED
  RELEASED
  ARCHIVED
}

enum DiaryFollowUpType {
  NOTE
  REFLECTION
  ACTION
  RESULT
}

model WxUser {
  id                 Int                    @id @default(autoincrement())
  openId             String                 @unique @map("open_id") @db.VarChar(64)
  accessToken        String                 @unique @map("access_token") @db.VarChar(128)
  nickname           String                 @default("记仇用户") @db.VarChar(64)
  avatar             String                 @default("") @db.VarChar(512)
  bio                String                 @default("") @db.VarChar(255)
  totalEntryCount    Int                    @default(0) @map("total_entry_count")
  activeEntryCount   Int                    @default(0) @map("active_entry_count")
  resolvedEntryCount Int                    @default(0) @map("resolved_entry_count")
  lastEntryAt        DateTime?              @map("last_entry_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  entries            DiaryEntry[]
  followUps          DiaryEntryFollowUp[]
  attachments        DiaryEntryAttachment[]

  @@index([createdAt])
  @@index([lastEntryAt])
  @@map("wx_user")
}

model DiaryCategory {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(64)
  description String       @default("") @db.VarChar(255)
  color       String       @default("#E85D75") @db.VarChar(16)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  entries     DiaryEntry[]

  @@index([sortOrder])
  @@map("diary_category")
}

model DiaryTag {
  id        Int             @id @default(autoincrement())
  name      String          @unique @db.VarChar(64)
  color     String          @default("#577590") @db.VarChar(16)
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  entryTags DiaryEntryTag[]

  @@index([sortOrder])
  @@map("diary_tag")
}

model DiaryEntry {
  id             Int                    @id @default(autoincrement())
  userId         Int                    @map("user_id")
  categoryId     Int?                   @map("category_id")
  title          String                 @db.VarChar(120)
  content        String                 @db.Text
  targetName     String                 @default("") @map("target_name") @db.VarChar(64)
  targetRelation String                 @default("") @map("target_relation") @db.VarChar(64)
  location       String                 @default("") @db.VarChar(128)
  grievanceLevel Int                    @default(3) @map("grievance_level")
  emotionLevel   Int                    @default(3) @map("emotion_level")
  followUpCount  Int                    @default(0) @map("follow_up_count")
  status         DiaryEntryStatus       @default(OPEN)
  isPinned       Boolean                @default(false) @map("is_pinned")
  happenedAt     DateTime               @map("happened_at")
  settledAt      DateTime?              @map("settled_at")
  lastFollowUpAt DateTime?              @map("last_follow_up_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  user           WxUser                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       DiaryCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags           DiaryEntryTag[]
  attachments    DiaryEntryAttachment[]
  followUps      DiaryEntryFollowUp[]

  @@index([userId, status, happenedAt])
  @@index([categoryId, happenedAt])
  @@index([isPinned, createdAt])
  @@index([lastFollowUpAt])
  @@map("diary_entry")
}

model DiaryEntryTag {
  id        Int        @id @default(autoincrement())
  entryId   Int        @map("entry_id")
  tagId     Int        @map("tag_id")
  createdAt DateTime   @default(now()) @map("created_at")
  entry     DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag       DiaryTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([entryId, tagId])
  @@index([tagId])
  @@map("diary_entry_tag")
}

model DiaryEntryAttachment {
  id        Int        @id @default(autoincrement())
  entryId   Int        @map("entry_id")
  userId    Int        @map("user_id")
  fileUrl   String     @map("file_url") @db.VarChar(512)
  fileName  String     @default("") @map("file_name") @db.VarChar(255)
  fileType  String     @default("image") @map("file_type") @db.VarChar(32)
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  entry     DiaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      WxUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, sortOrder])
  @@index([userId, createdAt])
  @@map("diary_entry_attachment")
}

model DiaryEntryFollowUp {
  id           Int               @id @default(autoincrement())
  entryId      Int               @map("entry_id")
  userId       Int               @map("user_id")
  type         DiaryFollowUpType @default(NOTE)
  content      String            @db.Text
  emotionDelta Int               @default(0) @map("emotion_delta")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  entry        DiaryEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user         WxUser            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
  @@index([userId, createdAt])
  @@map("diary_entry_follow_up")
}
