<view class="pr-root safe-bottom">
  <view class="pr-card">
    <view class="pr-title-row">
      <text class="pr-title">发财鸭明细</text>
      <text class="pr-sub">仅展示最近记录</text>
    </view>
    <view class="pr-list" wx:if="{{records.length}}">
      <view class="pr-row" wx:for="{{records}}" wx:key="createTime">
        <view class="pr-left">
          <text class="pr-content">{{item.content}}</text>
          <text class="pr-time">{{item.createTime}}</text>
        </view>
        <text class="pr-points {{item.points >= 0 ? 'pr-plus' : 'pr-minus'}}">
          {{item.points >= 0 ? '+' : ''}}{{item.points}}
        </text>
      </view>
    </view>
    <view class="pr-empty" wx:elif="{{!loading}}">
      <text class="pr-empty-text">暂无发财鸭记录</text>
    </view>
    <view class="pr-footer" wx:if="{{loading}}">加载中…</view>
    <view class="pr-footer" wx:elif="{{noMore && records.length}}">没有更多了</view>
  </view>
</view>

