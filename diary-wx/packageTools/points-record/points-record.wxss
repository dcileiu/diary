.pr-root {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.pr-card {
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.08);
  overflow: hidden;
}

.pr-title-row {
  padding: 26rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
}

.pr-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.pr-sub {
  font-size: 24rpx;
  color: #94a3b8;
}

.pr-list {
  display: flex;
  flex-direction: column;
}

.pr-row {
  padding: 22rpx 28rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f3f4f6;
}

.pr-row:last-child {
  border-bottom: none;
}

.pr-left {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pr-content {
  font-size: 30rpx;
  color: #111827;
  font-weight: 600;
}

.pr-time {
  font-size: 24rpx;
  color: #94a3b8;
}

.pr-points {
  font-size: 34rpx;
  font-weight: 800;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.pr-plus {
  color: #16a34a;
}

.pr-minus {
  color: #ef4444;
}

.pr-empty {
  padding: 120rpx 48rpx;
  text-align: center;
}

.pr-empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.pr-footer {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 24rpx 0 20rpx;
}

