<view class="guide-root">
  <view class="guide-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="guide-nav-inner">
      <view class="guide-back" bindtap="goBack">
        <image
          class="guide-back-icon"
          src="https://wallpaper.cdn.itianci.cn/imgs/miniapp/bg-left.svg"
          mode="aspectFit"
        ></image>
      </view>
      <text class="guide-nav-title">使用教程</text>
      <view class="guide-nav-side"></view>
    </view>
  </view>

  <view class="guide-main safe-bottom" style="padding-top: {{navBlockHeight}}px;">
    <view class="guide-hero card">
      <view class="guide-badge">快速上手</view>
      <view class="guide-hero-title">复制分享内容，三步完成解析</view>
      <view class="guide-hero-desc">
        首页支持粘贴分享口令、短链和文章链接。遇到问题时，可以先看下面的常见问题和操作说明。
      </view>
    </view>

    <view class="faq-board card">
      <view
        wx:for="{{guideItems}}"
        wx:key="id"
        class="faq-item {{openGuideId === item.id ? 'faq-item-open' : ''}}"
      >
        <view class="faq-head" data-id="{{item.id}}" bindtap="onToggleGuide">
          <view class="faq-title">{{item.title}}</view>
          <image
            class="faq-arrow {{openGuideId === item.id ? 'faq-arrow-open' : ''}}"
            src="https://wallpaper.cdn.itianci.cn/imgs/miniapp/bg-left.svg"
            mode="aspectFit"
          ></image>
        </view>

        <view class="faq-body" wx:if="{{openGuideId === item.id}}">
          <view wx:for="{{item.body}}" wx:key="*this" class="faq-text">
            {{item}}
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
