.guide-root {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 84% 14%,
      rgba(118, 187, 130, 0.16),
      transparent 24%
    ),
    radial-gradient(
      circle at 18% 88%,
      rgba(128, 197, 139, 0.12),
      transparent 30%
    ),
    linear-gradient(180deg, #f8fcf8 0%, #f3f9f4 52%, #edf5ef 100%);
}

.guide-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 1000;
  background: transparent;
}

.guide-nav-inner {
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guide-back,
.guide-nav-side {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.guide-back {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #8ea995;
  border: 2rpx solid #8ea995;
  color: #fff;
  font-size: 34rpx;
  line-height: 56rpx;
  text-align: center;
  box-sizing: border-box;
}

.guide-back-icon {
  width: 58rpx;
  height: 58rpx;
}

.guide-nav-title {
  min-width: 220rpx;
  text-align: center;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #203129;
}

.guide-main {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.guide-hero,
.faq-board {
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.6) 0%,
    rgba(255, 255, 255, 0.38) 100%
  );
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow:
    0 8rpx 32rpx rgba(15, 23, 42, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.46);
}

.guide-hero {
  padding: 30rpx 28rpx;
}

.guide-badge {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #22422b;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.78);
}

.guide-hero-title {
  display: block;
  margin-top: 22rpx;
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #15311d;
}

.guide-hero-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #4c6253;
}

.faq-board {
  margin-top: 24rpx;
  padding: 6rpx 0;
  overflow: hidden;
}

.faq-item {
  border-bottom: 1rpx solid rgba(128, 145, 136, 0.14);
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 30rpx 28rpx;
}

.faq-title {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #162b1b;
}


.faq-arrow {
  display: block;
  width: 48rpx;
  height: 48rpx;
  background-color: #8ea995;
  border-radius: 888rpx;
  transform: rotate(-90deg);
  transition: transform 0.2s ease;
}

.faq-arrow-open {
  transform: rotate(90deg);
}

.faq-body {
  padding: 0 28rpx 28rpx;
}

.faq-text {
  display: block;
  font-size: 25rpx;
  line-height: 1.8;
  color: #50655a;
}

.faq-text + .faq-text {
  margin-top: 10rpx;
}
