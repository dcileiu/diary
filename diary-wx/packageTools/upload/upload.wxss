.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f4faf5;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.hint-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.hint-line {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.55;
  margin-bottom: 10rpx;
}

.pick-btn {
  margin: 0 0 24rpx;
  background: linear-gradient(135deg, #4a9f5a 0%, #3d8b4c 100%);
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
  border: none;
}

.pick-btn[disabled] {
  opacity: 0.65;
}

.field {
  margin-bottom: 18rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.field-input {
  width: 100%;
  height: 76rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 12rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #111827;
  background: #fff;
}

.progress {
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.result-label {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.result-img {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  margin-bottom: 16rpx;
}

.result-url {
  font-size: 22rpx;
  color: #9ca3af;
  word-break: break-all;
}
