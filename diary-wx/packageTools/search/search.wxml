<view class="wrap">
  <view class="bar card">
    <input
      class="input"
      placeholder="输入组编号、主题或标签"
      value="{{keyword}}"
      bindinput="onInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <button class="btn" size="mini" bindtap="onSearch" loading="{{loading}}">搜索</button>
  </view>

  <view class="result-tip" wx:if="{{searched}}">
    <text>{{modeText}}</text>
    <text>共 {{total}} 条</text>
  </view>

  <view class="empty" wx:if="{{searched && !list.length}}">没有匹配结果</view>

  <view class="wf" wx:if="{{list.length}}">
    <view class="wf-col">
      <view
        wx:for="{{leftCol}}"
        wx:key="wallpapersId"
        class="wf-card"
        data-id="{{item.wallpapersId}}"
        bindtap="onTapItem"
      >
        <image class="wf-img" src="{{item.img}}" mode="widthFix" lazy-load="{{true}}" />
      </view>
    </view>
    <view class="wf-col">
      <view
        wx:for="{{rightCol}}"
        wx:key="wallpapersId"
        class="wf-card"
        data-id="{{item.wallpapersId}}"
        bindtap="onTapItem"
      >
        <image class="wf-img" src="{{item.img}}" mode="widthFix" lazy-load="{{true}}" />
      </view>
    </view>
  </view>
</view>
