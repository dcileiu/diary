.wrap {
  padding: 24rpx;
}

.bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
}

.input {
  flex: 1;
  font-size: 28rpx;
}

.btn {
  background: linear-gradient(
    135deg,
    rgb(49, 129, 65) 0%,
    rgb(128, 203, 149) 100%
  ) !important;
  color: #fff !important;
}

.result-tip {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #6b7280;
}

.empty {
  margin-top: 26rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}

.wf {
  margin-top: 18rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.wf-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wf-card {
  overflow: hidden;
  padding: 0;
  background: #fff;
  border-radius: 18rpx;
}

.wf-img {
  width: 100%;
  display: block;
  background: #f3f4f6;
}
