.cs-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.cs-card {
  padding: 40rpx 36rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.cs-label {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
}

.cs-qq {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
}

.cs-copy-btn {
  margin-top: 12rpx;
  width: 100%;
  max-width: 420rpx;
  height: 88rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border-radius: 44rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4a9f5a 0%, #2d6b36 100%);
}

.cs-copy-btn-hover {
  opacity: 0.92;
}

.cs-copy-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.15;
}

.cs-hint {
  display: block;
  margin-top: 28rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.55;
  text-align: center;
}
