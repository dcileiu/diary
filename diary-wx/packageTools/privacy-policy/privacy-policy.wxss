.policy-root {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 84% 14%,
      rgba(118, 187, 130, 0.16),
      transparent 24%
    ),
    radial-gradient(
      circle at 18% 88%,
      rgba(128, 197, 139, 0.12),
      transparent 30%
    ),
    linear-gradient(180deg, #f8fcf8 0%, #f3f9f4 52%, #edf5ef 100%);
}

.policy-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 1000;
  background: transparent;
}

.policy-nav-inner {
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.policy-back,
.policy-nav-side {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.policy-back {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #8ea995;
  border: 2rpx solid #8ea995;
  color: #fff;
  font-size: 34rpx;
  line-height: 56rpx;
  text-align: center;
  box-sizing: border-box;
}

.policy-back-icon {
  width: 58rpx;
  height: 58rpx;
}

.policy-nav-title {
  min-width: 220rpx;
  text-align: center;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #203129;
}

.policy-main {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.policy-hero,
.policy-board {
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.6) 0%,
    rgba(255, 255, 255, 0.38) 100%
  );
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow:
    0 8rpx 32rpx rgba(15, 23, 42, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.46);
}

.policy-hero {
  padding: 30rpx 28rpx;
}

.policy-badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #22422b;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.78);
}

.policy-hero-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #15311d;
}

.policy-hero-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #4c6253;
}

.policy-board {
  margin-top: 24rpx;
  padding: 16rpx 0 8rpx;
}

.policy-section {
  padding: 24rpx 28rpx 28rpx;
  border-bottom: 1rpx solid rgba(128, 145, 136, 0.14);
}

.policy-section:last-of-type {
  border-bottom: none;
}

.policy-title {
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #162b1b;
}

.policy-text {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #50655a;
}

.policy-updated {
  padding: 18rpx 28rpx 26rpx;
  font-size: 23rpx;
  color: #72847b;
}
