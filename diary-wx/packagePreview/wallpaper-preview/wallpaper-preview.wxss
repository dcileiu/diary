@import "../../styles/heart-like.wxss";

/* 磨砂玻璃与 custom-tab-bar .glass-button 一致 */
.preview-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #000000;
  box-sizing: border-box;
  overflow: hidden;
}

.preview-swiper {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.preview-slide {
  width: 100%;
  height: 100%;
}

.preview-img {
  width: 100%;
  height: 100%;
  display: block;
}

.preview-top {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  padding: 12rpx 24rpx 24rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.preview-top .preview-glass {
  pointer-events: auto;
}

.preview-time-wrap {
  position: fixed;
  left: 0;
  right: 0;
  top: 13%;
  z-index: 18;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.preview-time {
  font-size: 160rpx;
  line-height: 1;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.45);
}

.preview-date {
  margin-top: 14rpx;
  font-size: 56rpx;
  color: rgba(255, 255, 255, 0.86);
  text-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.42);
}

.preview-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.preview-bottom-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: center;
  gap: 24rpx;
  width: 100%;
  max-width: 720rpx;
  pointer-events: auto;
}

.preview-bottom .preview-bottom-row {
  pointer-events: auto;
}

.preview-glass {
  position: relative;
  height: 102rpx !important;
  width: fit-content;
  z-index: 3;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

.preview-close-glass {
  height: fit-content !important;
  padding: 18rpx 36rpx;
}

.preview-glass-text {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.88);
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.45);
}

.preview-save-glass {
  flex: 1;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.preview-share-glass {
  flex: 1;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.preview-share-btn {
  width: 100% !important;
  height: 100% !important;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  color: inherit;
  background: transparent;
  border: none;
}

.preview-share-btn::after {
  border: none;
}

.preview-collect-glass {
  flex: 1;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.preview-share-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.preview-collect-row {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.preview-share-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.preview-only-toggle-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 22;
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
}

.preview-preview-single {
  min-width: 320rpx;
}

.preview-collect-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.preview-save-glass-disabled {
  opacity: 0.55;
}

.preview-toast-wrap {
  position: fixed;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 200;
  display: flex;
  justify-content: center;
  padding: 0 48rpx;
  pointer-events: none;
}

.preview-toast-glass {
  max-width: 86%;
  padding: 28rpx 40rpx;
  border-radius: 24rpx;
}

.preview-toast-text {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.88);
  text-align: center;
  line-height: 1.45;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.45);
}

.insuf-mask {
  position: fixed;
  inset: 0;
  z-index: 260;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

.insuf-dialog {
  width: 100%;
  max-width: 640rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(22rpx);
  -webkit-backdrop-filter: blur(22rpx);
  border-radius: 24rpx;
  padding: 34rpx 30rpx 26rpx;
  box-sizing: border-box;
  box-shadow:
    0 18rpx 60rpx rgba(0, 0, 0, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

.insuf-title {
  font-size: 34rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
  text-align: center;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.45);
}

.insuf-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  text-align: center;
  line-height: 1.6;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}

.insuf-actions {
  margin-top: 26rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.insuf-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  background: linear-gradient(
    135deg,
    rgb(49, 129, 65) 0%,
    rgb(128, 203, 149) 100%
  );
  color: #fff;
  border: none;
}

.insuf-close {
  margin-top: 22rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.35);
}
