<view class="preview-page">
  <swiper
    class="preview-swiper"
    current="{{current}}"
    bindchange="onSwiperChange"
    duration="300"
    easing-function="easeOutCubic"
  >
    <swiper-item wx:for="{{list}}" wx:for-index="slideIndex" wx:key="wallpapersId">
      <view class="preview-slide">
        <image
          class="preview-img"
          src="{{slideIndex === current ? (item.imgFull || item.img) : item.img}}"
          mode="{{previewMode ? 'aspectFill' : (item._previewImageMode || 'aspectFit')}}"
          bindtap="onPreviewImageTap"
          lazy-load="{{slideIndex !== current}}"
          show-menu-by-longpress="{{false}}"
        />
      </view>
    </swiper-item>
  </swiper>

  <view class="preview-time-wrap">
    <view class="preview-time">{{clockTime}}</view>
    <view class="preview-date">{{dateText}}</view>
  </view>

  <view class="preview-top" wx:if="{{!previewMode}}" style="padding-top: {{statusBarHeight}}px;">
    <view class="preview-glass preview-close-glass" bindtap="onClose">
      <text class="preview-glass-text">关闭</text>
    </view>
  </view>

  <view class="preview-bottom" wx:if="{{!previewMode}}">
    <view class="preview-bottom-row">
      <view
        class="preview-glass preview-save-glass {{downloading ? 'preview-save-glass-disabled' : ''}}"
        bindtap="onDownloadTap"
      >
        <text class="preview-glass-text preview-save-text">{{downloading ? '下载中…' : '下载原图'}}</text>
      </view>
      <view class="preview-glass preview-share-glass">
        <button class="preview-share-btn" open-type="share" hover-class="none">
          <text class="preview-glass-text preview-share-text">分享朋友</text>
        </button>
      </view>
      <view class="preview-glass preview-collect-glass" bindtap="onCollectTap">
        <view class="preview-collect-row">
          <view class="heart-like heart-like--preview {{currentCollected ? 'heart-like--on' : ''}} {{collectHeartPop ? 'heart-like--pop' : ''}}">
            <view class="heart-like-inner">
              <image class="heart-like-img heart-like-outline" src="/images/heart-like-outline.svg" mode="aspectFit" />
              <image class="heart-like-img heart-like-filled" src="/images/heart-like-filled.svg" mode="aspectFit" />
              <view class="heart-like-celebrate" wx:if="{{collectHeartPop}}"></view>
            </view>
          </view>
          <text class="preview-glass-text preview-collect-text">{{currentCollected ? '已收藏' : '收藏'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="preview-toast-wrap" wx:if="{{toastShow}}">
    <view class="preview-glass preview-toast-glass">
      <text class="preview-toast-text">{{toastText}}</text>
    </view>
  </view>

  <view class="insuf-mask" wx:if="{{insufficientModalVisible}}" bindtap="closeInsufficientMungModal">
    <view class="insuf-dialog" catchtap="noop">
      <view class="insuf-title">发财鸭不足</view>
      <view class="insuf-desc">当前发财鸭：{{mungBean}}</view>
      <view class="insuf-desc">保存壁纸需消耗 {{saveCostPoints}} 发财鸭，可通过以下方式获取：</view>
      <view class="insuf-actions">
        <button class="insuf-btn" bindtap="onInsufficientSignTap">签到 +3</button>
        <button class="insuf-btn" open-type="share" bindtap="onInsufficientInviteTap">邀请好友 +15</button>
        <button class="insuf-btn" bindtap="onInsufficientWatchAdTap">看广告 +8</button>
      </view>
      <view class="insuf-close" bindtap="closeInsufficientMungModal">稍后再说</view>
    </view>
  </view>
</view>
