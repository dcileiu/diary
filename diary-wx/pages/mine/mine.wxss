.mine-title {
  text-align: center;
  font-size: 58rpx;
  font-weight: 800;
  color: #372119;
  margin-bottom: 24rpx;
}

.profile-card {
  padding: 26rpx 24rpx;
}

.profile-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-shell {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffd4e0 0%, #ffc6d2 100%);
  text-align: center;
  line-height: 108rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #9c4354;
}

.profile-main {
  flex: 1;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #382019;
}

.profile-level {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #906657;
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}

.progress-track {
  flex: 1;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(246, 220, 216, 0.72);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ec7690 0%, #e4566f 100%);
}

.progress-text {
  font-size: 24rpx;
  color: #8c6658;
}

.menu-panel {
  margin-top: 24rpx;
  padding: 8rpx 22rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(153, 104, 79, 0.08);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  color: #38211a;
}

.menu-arrow {
  font-size: 26rpx;
  color: #af8b79;
}

.quote-card {
  margin-top: 28rpx;
  padding: 38rpx 28rpx;
}

.quote-main {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.5;
  color: #41271f;
}

.quote-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #8a6456;
}
