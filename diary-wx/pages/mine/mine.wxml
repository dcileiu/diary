<view class="page-shell safe-bottom">
  <view class="mine-title">我的</view>

  <view class="hero-card profile-card">
    <view class="profile-top">
      <view class="avatar-shell">{{user && user.nickname ? user.nickname.slice(0, 1) : '记'}}</view>
      <view class="profile-main">
        <view class="profile-name">{{user && user.nickname ? user.nickname : '爱记仇的小可爱'}}</view>
        <view class="profile-level">记仇等级：Lv.{{levelInfo.level}}</view>
      </view>
    </view>

    <view class="progress-row">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{levelInfo.percent}}%;"></view>
      </view>
      <view class="progress-text">{{levelInfo.current}}/{{levelInfo.total}}</view>
    </view>
  </view>

  <view class="panel-card menu-panel">
    <block wx:for="{{menus}}" wx:for-item="menu" wx:key="key">
      <view class="menu-row" data-key="{{menu.key}}" bindtap="onMenuTap">
        <view class="menu-label">{{menu.label}}</view>
        <view class="menu-arrow">前往</view>
      </view>
    </block>
  </view>

  <view class="ghost-card quote-card">
    <view class="quote-main">记仇是本能，翻篇是选择。</view>
    <view class="quote-sub">但在翻篇之前，先把委屈认真记下来。</view>
  </view>
</view>
