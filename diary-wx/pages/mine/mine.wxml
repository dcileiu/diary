<view class="mine-root">
  <view class="mine-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="mine-nav-inner">
      <view class="mine-nav-side"></view>
      <text class="mine-nav-title">去水印壁纸鸭</text>
      <view class="mine-nav-side"></view>
    </view>
  </view>
  <view class="mine-main safe-bottom" style="padding-top: {{navBlockHeight}}px;">
  <view class="profile card">
    <image class="avatar" src="{{user.avatar}}" mode="aspectFill" />
    <view class="profile-text">
      <text class="nickname">{{user.nickname || '微信用户'}}</text>
      <text class="bio">记录美好的瞬间</text>
    </view>
  </view>

  <view class="stats card">
    <view
      class="stat-item stat-item-tap"
      hover-class="stat-item-hover"
      bindtap="onStatTap"
      data-kind="collect"
    >
      <text class="stat-value">{{collectSum}}</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat-divider"></view>
    <view
      class="stat-item stat-item-tap"
      hover-class="stat-item-hover"
      bindtap="onStatTap"
      data-kind="download"
    >
      <text class="stat-value">{{downloadSum}}</text>
      <text class="stat-label">下载</text>
    </view>
    <view class="stat-divider"></view>
    <view
      class="stat-item stat-item-tap highlight"
      hover-class="stat-item-hover"
      bindtap="onMungBeanTap"
    >
      <text class="stat-value">{{mungBean}}</text>
      <text class="stat-label">发财鸭</text>
    </view>
  </view>

  <view class="earn-row">
    <view class="earn-tile" bindtap="onDailySign">
      <text class="earn-title">每日签到</text>
      <text class="earn-sub">发财鸭+3/天</text>
    </view>
    <button class="earn-tile earn-tile-btn" open-type="share" bindtap="onShareEarnTap">
      <text class="earn-title">邀请好友</text>
      <text class="earn-sub">发财鸭+15/新用户</text>
    </button>
    <view class="earn-tile" bindtap="onWatchAd">
      <text class="earn-title">播放广告</text>
      <text class="earn-sub">发财鸭+8/次</text>
    </view>
  </view>

  <view class="menu card">
    <view class="menu-row" data-key="upload" bindtap="onMenuTap">
      <text class="menu-title">我的上传</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" data-key="comments" bindtap="onMenuTap">
      <text class="menu-title">我的评论</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" data-key="cache" bindtap="onMenuTap">
      <text class="menu-title">清除缓存</text>
      <text class="menu-extra">本地数据</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" data-key="contact" bindtap="onMenuTap">
      <text class="menu-title">联系客服</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" data-key="privacy" bindtap="onMenuTap">
      <text class="menu-title">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="mine-disclaimer">
    <view class="mine-disclaimer-text">免责声明：壁纸均来源于用户投稿上传，如有侵权私信删。</view>
  </view>
  </view>
</view>
