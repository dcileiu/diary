@import "../../styles/heart-like.wxss";

@keyframes nav-search-border-breathe {
  0%,
  100% {
    border-color: rgba(126, 188, 136, 0);
  }
  50% {
    border-color: #7ebc88;
  }
}

.page {
  min-height: 100vh;
  padding: 0 24rpx 0;
  background: #f4faf5;
}

.nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 8rpx 20rpx;
}

.nav-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}

.nav-title {
  width: fit-content;
  padding-right: 8rpx;
  flex: 0 1 auto;
  min-width: 0;
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: linear-gradient(105deg, #044701 0%, #4fc264 42%, #37814d 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.nav-icon-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-search {
  width: 66rpx;
  height: 66rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(126, 188, 136, 0);
  animation: nav-search-border-breathe 2.4s ease-in-out infinite;
}

.nav-search .search-glyph {
  font-size: 52rpx;
  height: fit-content;
  color: #6b7280;
}

.hero-wrap {
  position: relative;
  margin-bottom: 18rpx;
}

.hero-swiper {
  position: relative;
  height: 340rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.12);
}

.hero-slide {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-gradient {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(15, 23, 42, 0.45) 100%
  );
}

.hero-caption {
  position: absolute;
  left: 32rpx;
  bottom: 36rpx;
  z-index: 2;
  pointer-events: none;
}

.hero-caption-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.hero-caption-line {
  margin-top: 12rpx;
  width: 56rpx;
  height: 6rpx;
  background: #ffffff;
  border-radius: 4rpx;
  opacity: 0.95;
}

.section {
  margin-bottom: 18rpx;
}

.home-cat-flow {
  margin-bottom: 8rpx;
}

.home-tab-sentinel {
  height: 0;
}

.home-tab-shell {
  position: sticky;
  z-index: 100;
  margin-bottom: 10rpx;
}

.home-tab-shell--sticky {
  padding-top: 100rpx;
  margin-bottom: -44rpx;
  margin-left: -24rpx;
  margin-right: -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 16rpx;
  background: #f4faf5;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.08);
}

.section-head {
  margin-bottom: 16rpx;
}

.section-head.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d6b36;
}

.section-more {
  font-size: 26rpx;
  color: #9ca3af;
}

.home-tab-scroll {
  width: 100%;
  white-space: nowrap;
}

.home-tab-scroll--sticky {
  width: 78%;
}

.home-tab-row {
  display: inline-flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 36rpx;
  padding: 8rpx 4rpx;
}

.home-tab-scroll--sticky .home-tab-row {
  padding-right: 16rpx;
}

.home-tab-cell {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 8rpx;
  flex-shrink: 0;
}

.home-tab-label {
  font-size: 28rpx;
  color: #6b7280;
  font-weight: 400;
}

.home-tab-cell.active .home-tab-label {
  color: #2d6b36;
  font-weight: 700;
}

.home-tab-underline {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #4a9f5a;
  border-radius: 4rpx;
}

.hot-grid {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
}

.hot-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hot-card {
  overflow: hidden;
  position: relative;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.08);
}

.hot-img {
  width: 100%;
  display: block;
}

.hot-meta {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  right: 16rpx;
}

.hot-pill {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.45);
  backdrop-filter: blur(8px);
}

.hot-num {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.hot-footer-hint {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 24rpx 0 8rpx;
}

.hero-skeleton {
  margin-top: 8rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.skeleton-block {
  background: linear-gradient(90deg, #eef2f6 0%, #f6f7f9 50%, #eef2f6 100%);
  background-size: 200% 100%;
  animation: home-skel 1.2s ease-in-out infinite;
}

@keyframes home-skel {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: -100% 0;
  }
}

.skeleton-hero {
  width: 100%;
  height: 360rpx;
}

.hero-caption--skeleton {
  padding: 20rpx 8rpx 0;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 8rpx;
  max-width: 200rpx;
}

.skeleton-line--short {
  width: 160rpx;
}

.hot-skeleton-grid {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 8rpx;
}

.hot-card-skel {
  overflow: hidden;
  margin-bottom: 0;
}

.skeleton-card-img {
  width: 100%;
  height: 280rpx;
  border-radius: 24rpx;
}

.skeleton-card-img--tall {
  height: 340rpx;
}

.skeleton-pill {
  margin-top: 16rpx;
  width: 120rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #eef2f6;
}
