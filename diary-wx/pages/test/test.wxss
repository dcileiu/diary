.home-root {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at top right,
      rgba(74, 159, 90, 0.16),
      transparent 32%
    ),
    linear-gradient(180deg, #f8fcf8 0%, #f3f9f4 48%, #edf5ef 100%);
}

.home-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 1000;
  backdrop-filter: blur(14px);
}

.nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 24rpx 0rpx;
}

.nav-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
  height: 88rpx;
}

.nav-title {
  width: fit-content;
  padding-right: 8rpx;
  flex: 0 1 auto;
  min-width: 0;
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: linear-gradient(105deg, #044701 0%, #4fc264 42%, #37814d 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.home-main {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero,
.composer,
.tips,
.result,
.empty {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.result {
  padding-bottom: 200rpx;
}

.composer.card {
  padding: 22rpx 26rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(255, 255, 255, 0.28),
      transparent 32%
    ),
    linear-gradient(145deg, #2f7b40 0%, #162536 85%);
  box-shadow: 0 20rpx 52rpx rgba(22, 37, 54, 0.18);
}

.hero-badge {
  display: inline-flex;
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #0f2917;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.82);
}

.hero-title {
  display: block;
  margin-top: 20rpx;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #ffffff;
}

.hero-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.82);
}

.hero-platforms {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.hero-platform-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #f4fbf5;
  font-size: 22rpx;
}

.hero-actions,
.composer-actions,
.result-toolbar,
.media-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.hero-actions {
  margin-top: 28rpx;
}

.hero-btn,
.action-btn,
.mini-btn {
  margin: 0;
  border: none;
  line-height: 1;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.hero-btn::after,
.action-btn::after,
.mini-btn::after {
  border: none;
}

.hero-btn {
  min-width: 220rpx;
  padding: 24rpx 28rpx;
}

.action-btn {
  flex: 1;
  min-width: 0;
  padding: 24rpx 28rpx;
}

.mini-btn {
  min-width: 168rpx;
  padding: 18rpx 24rpx;
  font-size: 24rpx;
}

.hero-btn-primary,
.action-btn-primary,
.mini-btn-primary {
  background: #4a9f5a;
  color: #ffffff;
}

.hero-btn-ghost,
.action-btn-light,
.mini-btn {
  background: #f3f7f3;
  color: #294530;
  border: 2rpx solid #8ea995;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.section-head--result {
  align-items: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #102314;
}

.section-extra,
.result-meta,
.media-count {
  font-size: 22rpx;
  color: #7b8b7f;
}

.composer-input {
  width: 100%;
  height: 96rpx;
  margin-top: 18rpx;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #f5faf6;
  color: #1f2937;
  font-size: 26rpx;
}

.composer-tip {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7b8b7f;
}

.composer-actions {
  margin-top: 22rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.tip-item {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.tip-index {
  min-width: 48rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #4a9f5a;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #415347;
}

.result-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.result-chip {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #edf7ef;
  color: #2f7b40;
  font-size: 22rpx;
  font-weight: 700;
}

.result-title {
  display: block;
  margin-top: 20rpx;
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #13251a;
}

.result-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #758577;
}

.result-summary {
  display: block;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #405245;
}

.result-toolbar {
  margin-top: 24rpx;
}

.media-section {
  margin-top: 30rpx;
}

.media-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.media-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #13251a;
}

.video-card,
.image-card {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  background: #f6faf6;
  border: 1rpx solid rgba(74, 159, 90, 0.08);
}

.video-card + .video-card {
  margin-top: 18rpx;
}

.video-player {
  width: 100%;
  height: 360rpx;
  background: #09131c;
}

.media-body {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.media-body--video {
  position: static;
  width: auto;
}

.media-body--video .media-card-title {
  color: #14261a;
}

.media-body--video .media-card-sub {
  color: #7a8a7d;
}

.media-card-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

.media-card-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7a8a7d;
}

.media-warning {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #b45309;
}

.media-actions {
  margin-top: 18rpx;
}

.media-actions--inline {
  flex-wrap: nowrap;
}

.media-actions--inline .mini-btn {
  flex: 1;
  min-width: 0;
  padding: 12rpx;
  font-size: 22rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.image-card-img {
  width: 100%;
  height: 400rpx;
  display: block;
  background: #dce8de;
}

.empty {
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #13251a;
}

.empty-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #6f8072;
}

.empty-btn {
  margin-top: 24rpx;
}
