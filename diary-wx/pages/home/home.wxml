<view class="page-shell safe-bottom">
  <view class="hero-card hero-block">
    <view class="hero-top">
      <view>
        <view class="hero-title">记仇日记</view>
        <view class="hero-copy">记下让你不开心的事，从此记仇有据可查。</view>
      </view>
      <view class="hero-setting" bindtap="onSettingsTap">设</view>
    </view>
    <view class="hero-badge">今天也要先保护好自己</view>
  </view>

  <view class="panel-card calendar-panel">
    <view class="calendar-head">
      <view class="calendar-arrow" bindtap="onPrevMonth">上</view>
      <view class="calendar-month">{{monthLabel}}</view>
      <view class="calendar-actions">
        <view class="pill pill-outline today-pill" bindtap="onTodayTap">今天</view>
        <view class="calendar-arrow" bindtap="onNextMonth">下</view>
      </view>
    </view>

    <view class="weekday-row">
      <block wx:for="{{weekDays}}" wx:for-item="day" wx:key="*this">
        <view class="weekday-text">{{day}}</view>
      </block>
    </view>

    <block wx:for="{{calendarRows}}" wx:for-item="row" wx:key="index">
      <view class="calendar-row">
        <block wx:for="{{row}}" wx:for-item="cell" wx:key="key">
          <view
            class="calendar-cell {{cell.currentMonth ? '' : 'calendar-cell-empty'}}"
            data-cell="{{cell}}"
            bindtap="onDayTap"
          >
            <view
              class="calendar-bubble {{cell.toneClass}} {{cell.isSelected ? 'calendar-selected' : ''}} {{cell.isToday ? 'calendar-today' : ''}}"
            >
              {{cell.label}}
            </view>
            <view wx:if="{{cell.marker && cell.currentMonth}}" class="calendar-count">
              {{cell.marker.entryCount}}
            </view>
          </view>
        </block>
      </view>
    </block>
  </view>

  <view class="entry-card focus-card" bindtap="onEntryTap">
    <view wx:if="{{selectedEntry}}">
      <view class="focus-date">{{selectedEntryDateText}}</view>
      <view class="focus-content">{{selectedEntry.contentPreview}}</view>
      <view class="focus-footer">
        <view class="focus-stars">
          <block wx:for="{{stars}}" wx:for-item="star" wx:key="*this">
            <text class="focus-star {{star <= selectedEntry.grievanceLevel ? 'focus-star-on' : ''}}">★</text>
          </block>
        </view>
        <view class="pill pill-outline">{{selectedEntry.statusLabel}}</view>
      </view>
    </view>
    <view wx:else class="empty-state">这个月还没有新的记仇记录，先记一笔吧。</view>
  </view>

  <view class="primary-btn write-btn" bindtap="onWriteTap">+ 记一笔</view>

  <view class="panel-card summary-panel">
    <view class="summary-title">本月小结</view>
    <view class="summary-grid">
      <block wx:for="{{summaryItems}}" wx:for-item="summary" wx:key="label">
        <view class="summary-item">
          <view class="summary-value">
            {{summary.value}}<text class="summary-suffix">{{summary.suffix}}</text>
          </view>
          <view class="summary-label">{{summary.label}}</view>
        </view>
      </block>
    </view>
  </view>
</view>
