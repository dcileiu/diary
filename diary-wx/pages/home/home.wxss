.hero-block {
  padding: 30rpx 28rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-title {
  font-size: 64rpx;
  font-weight: 800;
  color: #3b2319;
}

.hero-copy {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #855d4f;
}

.hero-setting {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.76);
  text-align: center;
  line-height: 68rpx;
  font-size: 34rpx;
}

.hero-badge {
  display: inline-flex;
  margin-top: 20rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 246, 214, 0.92);
  color: #936248;
  font-size: 24rpx;
}

.calendar-panel {
  margin-top: 24rpx;
  padding: 26rpx 20rpx 18rpx;
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.calendar-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 242, 235, 0.95);
  text-align: center;
  line-height: 56rpx;
  color: #8d593f;
}

.calendar-month {
  font-size: 34rpx;
  font-weight: 700;
  color: #382019;
}

.calendar-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.today-pill {
  min-width: 96rpx;
}

.weekday-row,
.calendar-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.weekday-row {
  margin-top: 24rpx;
  margin-bottom: 10rpx;
}

.weekday-text {
  text-align: center;
  font-size: 24rpx;
  color: #947163;
}

.calendar-cell {
  position: relative;
  height: 82rpx;
}

.calendar-cell-empty {
  opacity: 0;
}

.calendar-bubble {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto;
  border-radius: 50%;
  text-align: center;
  line-height: 56rpx;
  font-size: 26rpx;
  color: #4a2b20;
}

.calendar-selected {
  box-shadow: 0 10rpx 22rpx rgba(211, 98, 79, 0.18);
  transform: scale(1.04);
}

.calendar-today {
  border: 2rpx dashed rgba(193, 93, 72, 0.55);
}

.cell-critical {
  background: rgba(249, 149, 171, 0.92);
}

.cell-high {
  background: rgba(249, 209, 117, 0.92);
}

.cell-mid {
  background: rgba(189, 177, 245, 0.92);
}

.cell-low {
  background: rgba(211, 229, 165, 0.92);
}

.calendar-count {
  position: absolute;
  top: 2rpx;
  right: 6rpx;
  min-width: 28rpx;
  padding: 2rpx 6rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 18rpx;
  color: #a16751;
  text-align: center;
}

.focus-card {
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
}

.focus-date {
  font-size: 28rpx;
  font-weight: 700;
  color: #704634;
}

.focus-content {
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.65;
  color: #342119;
}

.focus-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.focus-stars {
  display: flex;
  gap: 6rpx;
}

.focus-star {
  color: #e4c6c0;
  font-size: 26rpx;
}

.focus-star-on {
  color: #f17d97;
}

.write-btn {
  margin-top: 24rpx;
}

.summary-panel {
  margin-top: 24rpx;
  padding: 24rpx 22rpx;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #533428;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 18rpx;
}

.summary-item {
  text-align: center;
}

.summary-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #3a2018;
}

.summary-suffix {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #8a6658;
}

.summary-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8c6758;
}
