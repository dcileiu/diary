.stats-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #362018;
}

.month-picker {
  min-width: 172rpx;
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(165, 96, 63, 0.08);
  text-align: center;
  color: #7f5a4b;
}

.stats-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 24rpx;
}

.summary-label {
  font-size: 28rpx;
  color: #7d5749;
}

.summary-big {
  margin-top: 10rpx;
  font-size: 84rpx;
  font-weight: 800;
  color: #2f1d17;
}

.summary-unit {
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #7d594b;
}

.summary-delta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #896557;
}

.delta-up {
  color: #4da164;
}

.delta-down {
  color: #d65a63;
}

.summary-sign {
  width: 180rpx;
  height: 120rpx;
  border-radius: 26rpx;
  background: rgba(255, 250, 240, 0.95);
  text-align: center;
  line-height: 120rpx;
  font-size: 52rpx;
  font-weight: 800;
  color: #493027;
}

.chart-panel,
.top-panel {
  margin-top: 24rpx;
  padding: 26rpx 22rpx;
}

.chart-layout {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 26rpx;
}

.ring-shell {
  position: relative;
  width: 220rpx;
  height: 220rpx;
}

.ring-chart {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
}

.ring-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 108rpx;
  height: 108rpx;
  margin-left: -54rpx;
  margin-top: -54rpx;
  border-radius: 50%;
  background: #fff9f5;
}

.chart-legend {
  flex: 1;
  display: grid;
  gap: 16rpx;
}

.legend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.legend-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
}

.legend-label,
.legend-value {
  font-size: 26rpx;
  color: #725042;
}

.top-list {
  margin-top: 24rpx;
  display: grid;
  gap: 18rpx;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.top-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 223, 141, 0.95);
  text-align: center;
  line-height: 40rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #6d4d25;
}

.top-name {
  width: 140rpx;
  font-size: 28rpx;
  color: #3b241b;
}

.top-bar {
  flex: 1;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(239, 223, 218, 0.7);
  overflow: hidden;
}

.top-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ef8ba0 0%, #f7c35d 100%);
}

.top-count {
  width: 68rpx;
  text-align: right;
  font-size: 24rpx;
  color: #7f5c4d;
}
