.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.editor-title {
  font-size: 54rpx;
  font-weight: 800;
  color: #372119;
}

.save-chip {
  min-width: 118rpx;
  padding: 16rpx 0;
  border-radius: 999rpx;
  text-align: center;
  color: #fff;
  background: linear-gradient(135deg, #eb8096 0%, #d95b76 100%);
  font-size: 26rpx;
  font-weight: 700;
}

.editor-section {
  margin-bottom: 20rpx;
  padding: 24rpx 22rpx;
}

.field-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4a2c22;
}

.picker-row,
.single-input {
  height: 84rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 248, 244, 0.96);
  line-height: 84rpx;
  color: #473027;
  font-size: 28rpx;
}

.big-textarea,
.small-textarea {
  width: 100%;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 248, 244, 0.96);
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.7;
  color: #3b241d;
}

.big-textarea {
  height: 220rpx;
}

.small-textarea {
  height: 164rpx;
}

.field-count {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: #a17a6b;
}

.level-row,
.mood-row,
.status-row,
.tag-flow {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.level-chip,
.mood-chip {
  width: calc((100% - 28rpx) / 3);
  padding: 18rpx 0;
  border-radius: 22rpx;
  text-align: center;
  background: rgba(255, 249, 246, 0.96);
  border: 2rpx solid rgba(234, 219, 214, 0.9);
}

.level-chip-active,
.mood-chip-active {
  background: rgba(255, 220, 226, 0.9);
  border-color: rgba(225, 106, 129, 0.38);
}

.level-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #41251d;
}

.level-label,
.mood-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b6658;
}

.mood-emoji {
  font-size: 30rpx;
  font-weight: 700;
  color: #4d3127;
}

.tag-chip,
.status-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 243, 237, 0.96);
  color: #875949;
  font-size: 24rpx;
}

.tag-chip-active,
.status-chip-active {
  background: rgba(255, 212, 223, 0.9);
  color: #9a4354;
}
