.tabbar-wrapper {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
}

.button-wrap {
  position: relative;
  z-index: 2;
  align-self: center;
  /* 随三项文案收缩，类似「红框」紧贴文字 + 少量边距 */
  width: fit-content;
  max-width: 92%;
  margin: 0 auto;
  border-radius: 999rpx;
  background: transparent;
  pointer-events: auto;
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

.glass-button {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 8rpx 18rpx;
  width: fit-content;
  max-width: 100%;
  position: relative;
  z-index: 3;
  background: rgba(255, 255, 255, 0.35);
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
  transition:
    transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: transform;
}

.tab-span {
  position: relative;
  display: block;
  flex: 0 0 auto;
  text-align: center;
  user-select: none;
  font-weight: 600;
  font-size: 34rpx;
  /* 浅色底易吞掉深灰字；白字 + 深色晕边在亮/暗壁纸上都更易读 */
  color: rgba(255, 255, 255, 1);
  text-shadow:
    0 0 2rpx rgba(0, 0, 0, 0.65),
    0 1rpx 3rpx rgba(0, 0, 0, 0.8);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 26rpx 34rpx;
  box-sizing: border-box;
}

.tab-span:active {
  transform: scale(0.92);
  opacity: 0.7;
  transition: all 0.1s cubic-bezier(0.4, 0, 1, 1);
}

.tab-span.active {
  color: #4a9f5a;
  font-weight: 900;
}
